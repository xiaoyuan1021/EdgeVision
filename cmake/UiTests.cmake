option(EDGEVISION_UI_TESTS "Build production QWidget regression tests" OFF)
if(EDGEVISION_UI_TESTS)
    enable_testing()
    find_package(Qt6 REQUIRED COMPONENTS Test)
    foreach(suite ui_interaction application_workflow)
        add_executable(${suite}_test tests/${suite}_test.cpp ${RESOURCES})
        target_link_libraries(${suite}_test PRIVATE EdgeVisionRuntime Qt6::Test)
        set_target_properties(${suite}_test PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/bin")
        add_dependencies(${suite}_test EdgeVision)
        add_test(NAME ${suite} COMMAND ${suite}_test -platform offscreen
            -o "${CMAKE_BINARY_DIR}/${suite}-results.txt,txt")
        set_tests_properties(${suite} PROPERTIES TIMEOUT 120)
    endforeach()
endif()
